# ==============================================================================
# KONFIGURASI DATABASE CLOUD (OPSIONAL - UNTUK DEPLOY DI VERCEL / ONLINE HOSTING)
# ==============================================================================
# Jika Anda mendeploy website ini ke Vercel:
# Cukup buka Project Vercel -> Tab "Storage" -> Klik "Connect KV (Upstash)" -> Connect.
# Vercel akan otomatis mengisi variabel di bawah ini (100% GRATIS SELAMANYA).
#
# Setelah terhubung, setiap kali Owner mengubah produk di Panel Admin,
# perubahannya langsung tersimpan di Cloud dan bisa dilihat oleh semua customer!

KV_REST_API_URL=
KV_REST_API_TOKEN=

# Atau jika Anda membuat database Upstash Redis mandiri (https://upstash.com):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
